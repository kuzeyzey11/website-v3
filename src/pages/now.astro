---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="now — kuzyy" description="what kuzyy is currently working on">
  <div class="max-w-2xl mx-auto py-8 sm:py-16 space-y-8">
    <div class="space-y-2 border-b border-[#1f1f23] pb-4">
      <h1 class="text-lg font-medium text-[#fafafa]">now</h1>
      <p class="text-xs text-[#a1a1aa]">what I'm currently focused on.</p>
    </div>

    <div class="space-y-4 text-xs text-[#a1a1aa] leading-relaxed">
      <p>
        • refining custom linux window manager configs and dotfiles.<br/>
        • experimenting with local llm runtimes and open-source ai integrations.<br/>
        • dialing in coffee brew recipes and mobile kit setups.
      </p>
      <p class="pt-4 text-[11px] font-mono text-[#a1a1aa]">
        last updated: july 2026
      </p>
    </div>
  </div>
</BaseLayout>
