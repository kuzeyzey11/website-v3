---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="now — kuzyy" description="What kuzyy is currently working on and focused on.">
  <div class="max-w-2xl mx-auto py-12 sm:py-20 space-y-8">
    <div class="space-y-2 border-b border-[#1f1f23] pb-4">
      <h1 class="text-lg font-medium text-[#fafafa]">/now</h1>
      <p class="text-xs text-[#a1a1aa]">what i'm currently doing.</p>
    </div>

    <div class="space-y-4 text-xs text-[#a1a1aa] leading-relaxed">
      <p>Building minimal web projects, configuring Linux environments, and exploring open-source software.</p>
    </div>
  </div>
</BaseLayout>
