---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="uses — kuzyy" description="Hardware, software, and tools kuzyy uses daily.">
  <div class="max-w-2xl mx-auto py-12 sm:py-20 space-y-8">
    <div class="space-y-2 border-b border-[#1f1f23] pb-4">
      <h1 class="text-lg font-medium text-[#fafafa]">/uses</h1>
      <p class="text-xs text-[#a1a1aa]">gear, software, and setup details.</p>
    </div>

    <div class="space-y-6 text-xs text-[#a1a1aa] leading-relaxed">
      <section class="space-y-2">
        <h2 class="text-sm font-medium text-[#fafafa]">system</h2>
        <ul class="list-disc list-inside space-y-1">
          <li>OS: Arch Linux</li>
          <li>WM: Hyprland</li>
          <li>Terminal: Kitty</li>
          <li>Editor: Neovim</li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
