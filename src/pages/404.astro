---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not Found" description="Route not found on kuzyy.com">
  <div class="max-w-2xl mx-auto py-24 px-4 font-mono space-y-6">
    <div class="space-y-2 border-b border-[#1f1f23] pb-4">
      <div class="text-xs text-rose-400">Error 404: NO_SUCH_FILE_OR_DIRECTORY</div>
      <h1 class="text-xl font-medium text-[#fafafa]">zsh: command not found: route</h1>
    </div>

    <div class="text-xs text-[#a1a1aa] space-y-2 leading-relaxed">
      <p>The requested URL was not found on this server.</p>
      <p class="text-[11px] text-[#52525b]">Check the path spelling or return home.</p>
    </div>

    <div class="pt-4">
      <a
        href="/"
        class="inline-block px-3 py-1.5 rounded border border-[#27272a] bg-[#0c0c0e] text-xs text-[#fafafa] hover:border-[#3f3f46] transition-colors"
      >
        cd ~ (return home)
      </a>
    </div>
  </div>
</BaseLayout>
