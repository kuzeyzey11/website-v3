---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — kuzyy" description="page not found">
  <div class="max-w-2xl mx-auto py-24 space-y-4 text-left">
    <p class="text-xs font-mono text-[#a1a1aa]">404 error</p>
    
    <p id="silly-message" class="text-sm text-[#fafafa] font-medium leading-relaxed min-h-[2rem]">
      loading quantum excuses...
    </p>

    <div class="pt-6">
      <a href="/" class="text-xs text-[#a1a1aa] hover:text-[#fafafa] transition-colors underline underline-offset-4">
        ← back home
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  const messages = [
    "you stepped into a void. even arch linux can't compile this page.",
    "404: page took a coffee break and never came back.",
    "this link was eaten by a rogue local llm.",
    "nothing to see here, just cosmic background radiation.",
    "looks like you typed a url that only exists in parallel universe #404.",
    "error 404: the page was deleted to save 2kb of disk space.",
    "you stumbled into unpartitioned space.",
    "this route was left behind during `rm -rf /`."
  ];

  function setRandomMessage() {
    const el = document.getElementById('silly-message');
    if (el) {
      const msg = messages[Math.floor(Math.random() * messages.length)];
      el.textContent = msg;
    }
  }

  document.addEventListener('astro:page-load', setRandomMessage);
  document.addEventListener('DOMContentLoaded', setRandomMessage);
</script>
