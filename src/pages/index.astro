---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredProjects = [
  {
    title: 'website-v3',
    description: 'Personal minimal portfolio and blog built with Astro, Tailwind CSS, and TypeScript.',
    tech: ['Astro', 'TypeScript', 'Tailwind CSS'],
    github: 'https://github.com/kuzeyzey11/website-v3',
    link: 'https://kuzyy.com'
  },
  {
    title: 'dotfiles',
    description: 'Personal Arch Linux + Hyprland environment setup, Kitty terminal, and Neovim configs.',
    tech: ['Linux', 'Hyprland', 'Lua', 'Bash'],
    github: 'https://github.com/kuzeyzey11',
  }
];
---

<BaseLayout title="kuzyy — student & builder" description="Personal website of kuzyy. Exploring Linux, code, and minimal tools.">
  <div class="max-w-2xl mx-auto py-12 sm:py-20 space-y-12">
    
    <!-- Hero Section -->
    <section class="space-y-4">
      <h1 class="text-2xl font-medium text-[#fafafa]">kuzyy</h1>
      <p class="text-sm text-[#a1a1aa] leading-relaxed">
        Student and open-source enthusiast based in Türkiye. Focused on Linux systems, local AI tooling, and minimal web applications.
      </p>
      <div class="flex items-center gap-4 text-xs font-mono text-[#a1a1aa] pt-2">
        <a href="/projects" class="hover:text-[#fafafa] transition-colors">/projects</a>
        <a href="/blog" class="hover:text-[#fafafa] transition-colors">/blog</a>
        <a href="/terminal" class="hover:text-[#fafafa] transition-colors">/terminal</a>
        <a href="/uses" class="hover:text-[#fafafa] transition-colors">/uses</a>
        <a href="/now" class="hover:text-[#fafafa] transition-colors">/now</a>
      </div>
    </section>

    <!-- Projects Section -->
    <section class="space-y-4">
      <div class="flex items-center justify-between border-b border-[#1f1f23] pb-2">
        <h2 class="text-xs font-mono uppercase tracking-wider text-[#a1a1aa]">projects</h2>
        <a href="/projects" class="text-xs font-mono text-[#a1a1aa] hover:text-[#fafafa] transition-colors">view all →</a>
      </div>
      
      <div class="space-y-3">
        {featuredProjects.map((project) => (
          <div class="p-4 rounded-lg border border-[#1f1f23] bg-[#0c0c0e] space-y-2">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-medium text-[#fafafa]">{project.title}</h3>
              <div class="flex items-center gap-3 text-xs font-mono text-[#a1a1aa]">
                {project.github && (
                  <a href={project.github} target="_blank" rel="noreferrer" class="hover:text-[#fafafa] transition-colors">
                    github ↗
                  </a>
                )}
                {project.link && (
                  <a href={project.link} target="_blank" rel="noreferrer" class="hover:text-[#fafafa] transition-colors">
                    live ↗
                  </a>
                )}
              </div>
            </div>
            <p class="text-xs text-[#a1a1aa] leading-relaxed">{project.description}</p>
            <div class="flex flex-wrap gap-2 pt-1">
              {project.tech.map((t) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#18181b] text-[#a1a1aa] border border-[#27272a]">
                  {t}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Recent Blog Posts -->
    <section class="space-y-4">
      <div class="flex items-center justify-between border-b border-[#1f1f23] pb-2">
        <h2 class="text-xs font-mono uppercase tracking-wider text-[#a1a1aa]">recent posts</h2>
        <a href="/blog" class="text-xs font-mono text-[#a1a1aa] hover:text-[#fafafa] transition-colors">view all →</a>
      </div>
      
      <div class="space-y-3">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group block p-3 -mx-3 rounded-lg hover:bg-[#111113] transition-colors space-y-1"
          >
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-medium text-[#fafafa] group-hover:text-[#a1a1aa] transition-colors">
                {post.data.title.toLowerCase()}
              </h3>
              <span class="text-xs font-mono text-[#a1a1aa]">
                {post.data.pubDate.toISOString().split('T')[0]}
              </span>
            </div>
            <p class="text-xs text-[#a1a1aa] line-clamp-1">
              {post.data.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Contact Section -->
    <section class="space-y-4">
      <div class="border-b border-[#1f1f23] pb-2">
        <h2 class="text-xs font-mono uppercase tracking-wider text-[#a1a1aa]">contact</h2>
      </div>
      <p class="text-xs text-[#a1a1aa] leading-relaxed">
        Feel free to reach out via email or check out my work on GitHub.
      </p>
      <div class="flex flex-wrap items-center gap-4 text-xs font-mono">
        <a href="mailto:kuzeyzeyneloglu@gmail.com" class="text-[#fafafa] hover:underline">
          kuzeyzeyneloglu@gmail.com
        </a>
        <span class="text-[#3f3f46]">|</span>
        <a href="https://github.com/kuzeyzey11" target="_blank" rel="noreferrer" class="text-[#a1a1aa] hover:text-[#fafafa] transition-colors">
          github.com/kuzeyzey11 ↗
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
