---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'kuzyy',
  description = 'Student, builder, open source explorer.',
  image
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} image={image} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="kuzyy RSS Feed" href="/rss.xml" />
  </head>
  <body style="background-color: #09090b; color: #fafafa;" class="min-h-screen flex flex-col justify-between">
    <Header />
    <main class="flex-grow px-4">
      <slot />
    </main>
    <Footer />
  </body>
</html>
