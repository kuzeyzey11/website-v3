---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'kuzyy', description = 'Student, builder, open source explorer.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body style="background-color: #09090b; color: #fafafa;" class="min-h-screen flex flex-col justify-between">
    <Header />
    <main class="flex-grow px-4">
      <slot />
    </main>
    <Footer />
  </body>
</html>
