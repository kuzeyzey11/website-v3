---
interface Props {
  title: string;
  description: string;
  techStack: string[];
  slug: string;
}

const { title, description, techStack, slug } = Astro.props;
---

<a 
  href={`/projects/${slug}`}
  class="group block p-5 rounded-sm border border-[var(--color-border)] bg-[var(--color-surface)]/50 hover:border-[var(--color-accent)] transition-all duration-200"
>
  <div class="flex items-center justify-between mb-2">
    <h3 class="font-bold text-[var(--color-text-main)] group-hover:text-[var(--color-accent)] transition-colors">
      ./{title}
    </h3>
    <span class="text-xs font-mono text-[var(--color-prompt)] opacity-0 group-hover:opacity-100 transition-opacity">
      [view →]
    </span>
  </div>

  <p class="text-xs text-[var(--color-text-muted)] line-clamp-2 mb-4 leading-relaxed">
    {description}
  </p>

  <div class="flex flex-wrap gap-2 text-[10px] font-mono text-[var(--color-text-muted)]">
    {techStack.map((tech) => (
      <span class="px-2 py-0.5 rounded-sm border border-[var(--color-border)] bg-[var(--color-bg)]">
        #{tech}
      </span>
    ))}
  </div>
</a>
