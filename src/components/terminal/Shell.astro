---
---

<div class="w-full text-xs sm:text-sm space-y-4 terminal-font">
  <div id="terminal-body" class="space-y-3 min-h-[250px]">
    <div class="text-[#a1a1aa]">
      kuzyy shell — type <span class="text-[#fafafa]">help</span> to list commands.
    </div>

    <div id="history-container" class="space-y-3"></div>

    <div class="flex items-center gap-2 pt-1" id="prompt-line">
      <span class="text-[#a1a1aa] shrink-0">$</span>
      <input
        type="text"
        id="terminal-input"
        class="w-full bg-transparent outline-none text-[#fafafa] caret-[#fafafa] terminal-font"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
      />
    </div>
  </div>
</div>

<script>
  import { executeCommand, COMMANDS } from '../../lib/terminal';

  document.addEventListener('astro:page-load', initTerminal);
  document.addEventListener('DOMContentLoaded', initTerminal);

  function initTerminal() {
    const input = document.getElementById('terminal-input') as HTMLInputElement;
    const historyContainer = document.getElementById('history-container');

    if (!input || !historyContainer) return;

    let history: string[] = JSON.parse(localStorage.getItem('kuzyy_cmd_history') || '[]');
    let historyIdx = history.length;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.tagName !== 'A' && window.innerWidth > 640) {
        input.focus();
      }
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        e.preventDefault();
        const val = input.value.trim().toLowerCase();
        if (!val) return;

        const matches = COMMANDS.filter(c => c.startsWith(val));
        if (matches.length === 1) {
          input.value = matches[0];
        }
        return;
      }

      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (historyIdx > 0) {
          historyIdx--;
          input.value = history[historyIdx] || '';
        }
        return;
      }

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIdx < history.length - 1) {
          historyIdx++;
          input.value = history[historyIdx] || '';
        } else {
          historyIdx = history.length;
          input.value = '';
        }
        return;
      }

      if (e.key === 'Enter') {
        const raw = input.value;
        input.value = '';

        if (raw.trim()) {
          history.push(raw.trim());
          localStorage.setItem('kuzyy_cmd_history', JSON.stringify(history));
          historyIdx = history.length;
        }

        const result = executeCommand(raw);

        if (result.clear) {
          historyContainer.innerHTML = '';
          return;
        }

        appendHistory(`$ ${raw}`, result.output);

        if (result.openUrl) {
          window.open(result.openUrl, '_blank');
        }

        if (result.navigate) {
          setTimeout(() => {
            window.location.href = result.navigate!;
          }, 300);
        }
      }
    });

    function appendHistory(promptText: string, outputText: string) {
      const block = document.createElement('div');
      block.className = 'space-y-1 terminal-font';

      const cmdLine = document.createElement('div');
      cmdLine.className = 'text-[#fafafa]';
      cmdLine.textContent = promptText;

      const outLine = document.createElement('pre');
      outLine.className = 'whitespace-pre-wrap text-xs sm:text-sm text-[#a1a1aa] terminal-font';
      outLine.textContent = outputText;

      block.appendChild(cmdLine);
      if (outputText) block.appendChild(outLine);

      historyContainer.appendChild(block);
    }
  }
</script>
